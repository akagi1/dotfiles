shift + alt - q : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; yabai -m window --close
alt - return : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; open -a Terminal
shift + alt - r : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; yabai --restart-service; sketchybar --reload
shift + alt - w : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; yabai -m space --balance
alt - 1 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; skhd -k 'ctrl - 1'
