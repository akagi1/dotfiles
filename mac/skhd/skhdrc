# Option is the Windows Alt equivalent.
alt - h : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; yabai -m window --focus west
shift + alt - h : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; yabai -m window --warp west
alt - j : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; yabai -m window --focus south
shift + alt - j : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; yabai -m window --warp south
